# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ขึ้น git)
#
# BREVO_API_KEY   คีย์ API ของ Brevo (https://app.brevo.com) ใช้ส่งอีเมลแจ้งเตือน
# SMTP_USERNAME   อีเมลผู้ส่ง ต้องเป็นอีเมลที่ยืนยันตัวตนไว้กับ Brevo แล้ว
# SMTP_FROM_NAME  ชื่อผู้ส่งที่ผู้รับจะเห็น
#
# CLOUDINARY_CLOUD_NAME  ชื่อ cloud จาก Cloudinary Dashboard > Account Details
# CLOUDINARY_API_KEY     API Key จาก Cloudinary Dashboard > Account Details
# CLOUDINARY_API_SECRET  API Secret จาก Cloudinary Dashboard > Account Details

BREVO_API_KEY=
SMTP_USERNAME=
SMTP_FROM_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
